# ============================================================
# BB610 Market
# Git contains source code and source catalog only.
# Server runtime data must NEVER be stored in Git.
# ============================================================

# Environment / secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# BB610 Market runtime data
# Orders database, uploaded product images and other live data.
backend/runtime/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log

# Generated catalog/build output
/products/
/categories/
data/catalog.generated.json
data/catalog.runtime.js
feeds/google-merchant.csv
feeds/meta-catalog.csv
feeds/merchant-meta-template.csv
feeds/feed-status.json
sitemap.xml
robots.txt
