#!/usr/bin/env bash
set -euo pipefail

ROOT=/opt/bb610-market
CMD="${SSH_ORIGINAL_COMMAND:-}"

audit() {
  cd "$ROOT"
  echo "========== BB610 VPS =========="
  echo "HEAD: $(git rev-parse HEAD)"
  echo "BRANCH: $(git branch --show-current)"
  echo "--- TRACKED CHANGES ---"
  git status --short --untracked-files=no || true
  echo "--- V2 ---"
  if [ -f backend/services/product_cards_v2.py ]; then
    echo "product_cards_v2.py: PRESENT"
  else
    echo "product_cards_v2.py: ABSENT"
  fi
  echo "--- V3 ---"
  if [ -d data/product_cards_v3/products ]; then
    find data/product_cards_v3/products -maxdepth 1 -name 'prd_*.json' -type f | wc -l
  else
    echo 0
  fi
  echo "--- SERVICE ---"
  systemctl is-active bb610-market
  echo "========== END =========="
}

health() {
  systemctl is-active bb610-market
  curl -fsS --max-time 15 https://api.market.bb610.com.ua/api/v1/health
  echo
}

snapshot() {
  cd "$ROOT"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  git fetch -q origin main
  git show origin/main:ops/export_v5_snapshot.py > "$tmp/export_v5_snapshot.py"
  python3 "$tmp/export_v5_snapshot.py" --root "$ROOT" --out "$tmp/snapshot"
  tar -C "$tmp/snapshot" -czf - .
}

deploy() {
  sha="${1:-}"
  [[ "$sha" =~ ^[0-9a-fA-F]{7,40}$ ]] || exit 64
  cd "$ROOT"
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "REFUSED: tracked working tree is not clean"
    git status --short --untracked-files=no
    exit 65
  fi
  git fetch origin main
  git cat-file -e "${sha}^{commit}" 2>/dev/null || exit 66
  git merge-base --is-ancestor "$sha" origin/main || exit 67
  git merge-base --is-ancestor HEAD "$sha" || exit 68
  git merge --ff-only "$sha"
  systemctl restart bb610-market
  sleep 2
  systemctl is-active bb610-market
  curl -fsS --max-time 15 https://api.market.bb610.com.ua/api/v1/health
  echo
}

case "$CMD" in
  audit) audit ;;
  health) health ;;
  snapshot) snapshot ;;
  deploy\ *) deploy "${CMD#deploy }" ;;
  *) echo "DENIED"; exit 126 ;;
esac
