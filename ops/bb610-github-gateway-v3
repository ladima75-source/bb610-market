#!/usr/bin/env bash
set -euo pipefail

ROOT=/opt/bb610-market
MAGELLE_ROOT=/opt/magelle
TWOFAMILY_EPHEMERAL_PUBKEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEbc4THlSp1mQ/Jy3jwMziCnjExardCw9NlbdnthmJ8h twofamily-ephemeral-2026-09-29"
CMD="${SSH_ORIGINAL_COMMAND:-}"

# These legacy files are mutated by the running application on production.
# They are preserved byte-for-byte across V5 shadow deployments.
RUNTIME_TRACKED=(
  data/media.library.json
  data/product_cards.master.json
  data/product_cards_v3/commerce_map.json
  data/product_cards_v3/index.json
  data/product_cards_v3/migration_manifest.json
)

tracked_dirty() {
  cd "$ROOT"
  git status --porcelain --untracked-files=no
}

assert_only_runtime_dirty() {
  cd "$ROOT"
  local bad=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local path="${line:3}"
    local ok=0
    for allowed in "${RUNTIME_TRACKED[@]}"; do
      if [ "$path" = "$allowed" ]; then
        ok=1
        break
      fi
    done
    if [ "$ok" -ne 1 ]; then
      echo "REFUSED: unexpected tracked change: $path"
      bad=1
    fi
  done < <(tracked_dirty)
  [ "$bad" -eq 0 ] || exit 65
}

audit() {
  cd "$ROOT"
  echo "========== BB610 VPS =========="
  echo "HEAD: $(git rev-parse HEAD)"
  echo "BRANCH: $(git branch --show-current)"
  echo "ORIGIN_MAIN: $(git rev-parse origin/main 2>/dev/null || echo unknown)"
  echo
  echo "--- TRACKED CHANGES ---"
  tracked_dirty || true
  echo
  echo "--- V5 ---"
  if [ -f v5/staging/production-current.json ]; then
    python3 - <<'PY'
import json
from pathlib import Path
p=Path("v5/staging/production-current.json")
d=json.loads(p.read_text(encoding="utf-8"))
print(json.dumps(d.get("summary",{}),ensure_ascii=False,indent=2))
PY
  else
    echo "V5 staging: ABSENT"
  fi
  echo
  echo "--- SERVICE ---"
  systemctl show bb610-market -p ActiveState -p SubState -p WorkingDirectory --no-pager
  echo "========== END =========="
}

v5_health() {
  local tmp
  tmp="$(mktemp)"
  curl -fsS --max-time 30 https://api.market.bb610.com.ua/api/v1/catalog/v5 > "$tmp"
  python3 - "$tmp" <<'PY'
import json,sys
d=json.load(open(sys.argv[1],encoding="utf-8"))
c=d.get("counts") or {}
print("V5:", json.dumps({
  "schema_version": d.get("schema_version"),
  "products": c.get("products"),
  "public_products": c.get("public_products"),
  "skus": c.get("skus"),
  "public_skus": c.get("public_skus"),
  "sku_aliases": c.get("sku_aliases"),
  "media": c.get("media"),
}, ensure_ascii=False))
if d.get("schema_version") != "5.0":
    raise SystemExit("unexpected V5 schema")
required = {
    "products": 119,
    "public_products": 115,
    "skus": 310,
    "public_skus": 298,
    "sku_aliases": 109,
    "media": 434,
}
missing = {k: (c.get(k), minimum) for k, minimum in required.items()
           if not isinstance(c.get(k), int) or c.get(k) < minimum}
if missing:
    raise SystemExit("unexpected V5 count regression: " + json.dumps(missing, ensure_ascii=False))
if c["public_products"] > c["products"] or c["public_skus"] > c["skus"]:
    raise SystemExit("invalid V5 public/total count relationship")
PY
  rm -f "$tmp"
}

health() {
  echo "SERVICE:"
  systemctl is-active bb610-market
  echo "API:"
  curl -fsS --max-time 15 https://api.market.bb610.com.ua/api/v1/health
  echo
  v5_health
}

snapshot() {
  cd "$ROOT"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  git fetch -q origin main
  git show origin/main:ops/export_v5_snapshot.py > "$tmp/export_v5_snapshot.py"
  python3 "$tmp/export_v5_snapshot.py" --root "$ROOT" --out "$tmp/snapshot"
  tar -C "$tmp/snapshot" -czf - .
}

deploy() {
  local sha="${1:-}"
  [[ "$sha" =~ ^[0-9a-fA-F]{7,40}$ ]] || {
    echo "Invalid commit SHA"
    exit 64
  }

  cd "$ROOT"
  assert_only_runtime_dirty

  git fetch origin main
  git cat-file -e "${sha}^{commit}" 2>/dev/null || {
    echo "REFUSED: commit not found"
    exit 66
  }
  git merge-base --is-ancestor "$sha" origin/main || {
    echo "REFUSED: requested commit is not on origin/main"
    exit 67
  }
  git merge-base --is-ancestor HEAD "$sha" || {
    echo "REFUSED: deployment would not be fast-forward"
    exit 68
  }

  local before
  before="$(git rev-parse HEAD)"
  local tmp
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN

  # Preserve only the approved application-mutated files.
  for rel in "${RUNTIME_TRACKED[@]}"; do
    if [ -f "$rel" ]; then
      mkdir -p "$tmp/$(dirname "$rel")"
      cp -a "$rel" "$tmp/$rel"
    fi
  done

  # Clean the approved runtime mutations so the fast-forward cannot be blocked.
  git checkout -- "${RUNTIME_TRACKED[@]}"

  echo "BEFORE: $before"
  echo "TARGET: $sha"
  git merge --ff-only "$sha"

  # Restore production runtime state byte-for-byte.
  for rel in "${RUNTIME_TRACKED[@]}"; do
    if [ -f "$tmp/$rel" ]; then
      cp -a "$tmp/$rel" "$rel"
    fi
  done

  # Refuse to start if deployment itself introduced an unexpected tracked edit.
  assert_only_runtime_dirty

  systemctl restart bb610-market
  sleep 2

  echo "SERVICE:"
  systemctl is-active bb610-market
  echo "API:"
  curl -fsS --max-time 15 https://api.market.bb610.com.ua/api/v1/health
  echo
  echo "DEPLOYED: $(git rev-parse HEAD)"
  echo "V5 SHADOW CHECK:"
  v5_health
  echo "PRESERVED_RUNTIME_TRACKED:"
  tracked_dirty || true
}

shadow() {
  cd "$ROOT"
  python3 ops/v5_shadow_compare.py
}

head_bundle() {
  cd "$ROOT"
  git bundle create - HEAD
}

magelle_audit() {
  echo "========== MAGELLE VPS =========="
  if [ -d "$MAGELLE_ROOT/.git" ]; then
    cd "$MAGELLE_ROOT"
    git fetch -q origin main || true
    echo "HEAD: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
    echo "ORIGIN_MAIN: $(git rev-parse origin/main 2>/dev/null || echo unknown)"
    git status --short --untracked-files=no || true
  else
    echo "REPO: ABSENT"
  fi
  echo "--- SERVICE ---"
  systemctl show magelle-admin -p ActiveState -p SubState -p WorkingDirectory --no-pager 2>/dev/null || echo "magelle-admin: NOT_INSTALLED"
  echo "--- LOCAL HEALTH ---"
  curl -fsS --max-time 10 http://127.0.0.1:8787/api/health 2>/dev/null || echo "health: unavailable"
  echo
  echo "========== END =========="
}

magelle_bootstrap() {
  if [ ! -d "$MAGELLE_ROOT/.git" ]; then
    git clone https://github.com/ladima75-source/magelle.git "$MAGELLE_ROOT"
  fi
  cd "$MAGELLE_ROOT"
  git fetch origin main
  git reset --hard origin/main

  python3 -m venv "$MAGELLE_ROOT/venv"
  "$MAGELLE_ROOT/venv/bin/pip" install --upgrade pip
  "$MAGELLE_ROOT/venv/bin/pip" install -r "$MAGELLE_ROOT/server/requirements.txt"

  if ! getent group www-data >/dev/null 2>&1; then groupadd --system www-data; fi
  if ! id -u www-data >/dev/null 2>&1; then useradd --system -g www-data -d /nonexistent -s /sbin/nologin www-data; fi
  install -d -m 0750 -o www-data -g www-data /var/lib/magelle
  chown -R www-data:www-data "$MAGELLE_ROOT/server"

  if [ ! -f /etc/magelle-admin.env ]; then
    local admin_password session_secret
    admin_password="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(18))
PY
)"
    session_secret="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(48))
PY
)"
    cat > /etc/magelle-admin.env <<EOF
MAGELLE_ADMIN_PASSWORD=$admin_password
MAGELLE_SESSION_SECRET=$session_secret
MAGELLE_DB=/var/lib/magelle/admin.db
MAGELLE_ORIGIN=https://magelle.com.ua
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EOF
    chmod 600 /etc/magelle-admin.env
    printf '%s\n' "$admin_password" > /root/magelle-admin-initial-password.txt
    chmod 600 /root/magelle-admin-initial-password.txt
    echo "MAGELLE_ADMIN_PASSWORD=CREATED_AND_STORED_ROOT_ONLY"
  else
    if [ ! -f /root/magelle-admin-initial-password.txt ]; then
      local rotated_password
      rotated_password="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(18))
PY
)"
      sed -i "s|^MAGELLE_ADMIN_PASSWORD=.*$|MAGELLE_ADMIN_PASSWORD=$rotated_password|" /etc/magelle-admin.env
      printf '%s\n' "$rotated_password" > /root/magelle-admin-initial-password.txt
      chmod 600 /root/magelle-admin-initial-password.txt
      echo "MAGELLE_ADMIN_PASSWORD=ROTATED_AND_STORED_ROOT_ONLY"
    else
      echo "MAGELLE_ADMIN_PASSWORD=EXISTING"
    fi
  fi

  cp "$MAGELLE_ROOT/server/magelle-admin.service" /etc/systemd/system/magelle-admin.service
  if [ -d /etc/nginx/sites-available ]; then
    cp "$MAGELLE_ROOT/server/nginx-magelle-admin.conf" /etc/nginx/sites-available/magelle-admin.conf
    mkdir -p /etc/nginx/sites-enabled
    ln -sfn /etc/nginx/sites-available/magelle-admin.conf /etc/nginx/sites-enabled/magelle-admin.conf
  else
    cp "$MAGELLE_ROOT/server/nginx-magelle-admin.conf" /etc/nginx/conf.d/magelle-admin.conf
  fi

  systemctl daemon-reload
  systemctl enable --now magelle-admin
  nginx -t
  systemctl reload nginx
  sleep 2
  curl -fsS --max-time 15 http://127.0.0.1:8787/api/health
  echo
}

magelle_health() {
  systemctl is-active magelle-admin
  curl -fsS --max-time 15 http://127.0.0.1:8787/api/health
  echo
}

magelle_admin_check() {
  echo "--- SERVICE ---"
  systemctl is-active magelle-admin
  echo "--- ADMIN PAGE ---"
  curl -ksS -o /tmp/magelle-admin-page -w '%{http_code}\n' https://api.magelle.com.ua/admin/
  head -c 120 /tmp/magelle-admin-page; echo
  echo "--- LOGIN EMPTY TEST ---"
  curl -ksS -o /tmp/magelle-login -w '%{http_code}\n' -H 'Content-Type: application/json' -d '{"password":""}' https://api.magelle.com.ua/api/admin/login
  cat /tmp/magelle-login; echo
  echo "--- PASSWORD FILE ---"
  if [ -s /root/magelle-admin-initial-password.txt ]; then
    echo "present"
  else
    echo "missing"
  fi
}

magelle_public() {
  echo "--- NGINX ---"
  nginx -t
  echo "--- HTTP HOST ROUTING ---"
  curl -fsS --max-time 15 -H 'Host: api.magelle.com.ua' http://127.0.0.1/api/health
  echo
  echo "--- LISTENER ---"
  ss -lntp | grep -E ':(80|443|8787)\b' || true
}

magelle_tls() {
  local resolved
  resolved="$(getent ahostsv4 api.magelle.com.ua | awk 'NR==1{print $1}')"
  if [ "$resolved" != "173.242.53.156" ]; then
    echo "REFUSED: api.magelle.com.ua does not resolve to VPS (got: ${resolved:-none})"
    exit 70
  fi
  if ! command -v certbot >/dev/null 2>&1; then
    if command -v dnf >/dev/null 2>&1; then
      dnf -y install certbot python3-certbot-nginx
    elif command -v yum >/dev/null 2>&1; then
      yum -y install certbot python3-certbot-nginx
    else
      echo "REFUSED: certbot unavailable and no supported package manager"
      exit 71
    fi
  fi
  certbot --nginx -d api.magelle.com.ua --non-interactive --agree-tos --register-unsafely-without-email --redirect
  nginx -t
  systemctl reload nginx
  curl -fsS --max-time 20 https://api.magelle.com.ua/api/health
  echo
}

magelle_deploy() {
  local sha="${1:-}"
  [[ "$sha" =~ ^[0-9a-fA-F]{7,40}$ ]] || { echo "Invalid commit SHA"; exit 64; }
  [ -d "$MAGELLE_ROOT/.git" ] || { echo "MaGelle repo absent; run magelle-bootstrap"; exit 69; }
  cd "$MAGELLE_ROOT"
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "REFUSED: tracked working tree is not clean"
    git status --short --untracked-files=no
    exit 65
  fi
  git fetch origin main
  git cat-file -e "${sha}^{commit}" 2>/dev/null || exit 66
  git merge-base --is-ancestor "$sha" origin/main || exit 67
  git merge-base --is-ancestor HEAD "$sha" || exit 68
  git merge --ff-only "$sha"
  "$MAGELLE_ROOT/venv/bin/pip" install -r "$MAGELLE_ROOT/server/requirements.txt"
  cp "$MAGELLE_ROOT/server/magelle-admin.service" /etc/systemd/system/magelle-admin.service
  if [ -d /etc/nginx/sites-available ]; then
    cp "$MAGELLE_ROOT/server/nginx-magelle-admin.conf" /etc/nginx/sites-available/magelle-admin.conf
    mkdir -p /etc/nginx/sites-enabled
    ln -sfn /etc/nginx/sites-available/magelle-admin.conf /etc/nginx/sites-enabled/magelle-admin.conf
  else
    cp "$MAGELLE_ROOT/server/nginx-magelle-admin.conf" /etc/nginx/conf.d/magelle-admin.conf
  fi
  systemctl daemon-reload
  systemctl restart magelle-admin
  nginx -t
  systemctl reload nginx
  sleep 2
  magelle_health
}


twofamily_audit() {
  echo "========== TWOFAMILY VPS =========="
  echo "DNS: $(getent ahostsv4 social.bb610.com.ua | awk 'NR==1{print $1}' || true)"
  for cmd in git python3 npm curl psql pg_dump ffmpeg ffprobe nginx systemctl certbot; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '%s: ' "$cmd"
      command -v "$cmd"
    else
      echo "$cmd: MISSING"
    fi
  done
  echo "--- PORTS ---"
  ss -lntp | grep -E ':(80|443|8100)\\b' || true
  echo "--- TWOFAMILY ---"
  [ -d /opt/twofamily-social-control ] && echo "app_dir: PRESENT" || echo "app_dir: ABSENT"
  systemctl is-active twofamily-social-api.service 2>/dev/null || true
  echo "========== END =========="
}

twofamily_authorize_ephemeral() {
  install -d -m 0700 /root/.ssh
  touch /root/.ssh/authorized_keys
  chmod 0600 /root/.ssh/authorized_keys
  local tmp
  tmp="$(mktemp)"
  grep -v 'twofamily-ephemeral-2026-09-29' /root/.ssh/authorized_keys > "$tmp" || true
  printf '%s\\n' "$TWOFAMILY_EPHEMERAL_PUBKEY" >> "$tmp"
  cat "$tmp" > /root/.ssh/authorized_keys
  rm -f "$tmp"
  chmod 0600 /root/.ssh/authorized_keys
  echo "TWOFAMILY_EPHEMERAL=AUTHORIZED"
}

twofamily_revoke_ephemeral() {
  [ -f /root/.ssh/authorized_keys ] || { echo "TWOFAMILY_EPHEMERAL=ABSENT"; return 0; }
  local tmp
  tmp="$(mktemp)"
  grep -v 'twofamily-ephemeral-2026-09-29' /root/.ssh/authorized_keys > "$tmp" || true
  cat "$tmp" > /root/.ssh/authorized_keys
  rm -f "$tmp"
  chmod 0600 /root/.ssh/authorized_keys
  echo "TWOFAMILY_EPHEMERAL=REVOKED"
}


twofamily_enable_deploy_user() {
  local key_line
  key_line="$(grep 'twofamily-social-control' /root/.ssh/authorized_keys | tail -n 1 || true)"
  [ -n "$key_line" ] || { echo "REFUSED: TwoFamily public key not found"; exit 72; }

  if ! id -u twofamily-deploy >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash twofamily-deploy
  fi

  chown twofamily-deploy:twofamily-deploy /home/twofamily-deploy
  chmod 0700 /home/twofamily-deploy
  install -d -m 0700 -o twofamily-deploy -g twofamily-deploy /home/twofamily-deploy/.ssh
  printf '%s\n' "$key_line" > /home/twofamily-deploy/.ssh/authorized_keys
  chown twofamily-deploy:twofamily-deploy /home/twofamily-deploy/.ssh/authorized_keys
  chmod 0600 /home/twofamily-deploy/.ssh/authorized_keys
  if command -v restorecon >/dev/null 2>&1; then
    restorecon -RF /home/twofamily-deploy >/dev/null 2>&1 || true
  fi

  install -d -m 0750 -o twofamily-deploy -g twofamily-deploy /home/twofamily-deploy/upload
  echo "TWOFAMILY_DEPLOY_USER=READY"
}


twofamily_ssh_diag() {
  echo "--- USER ---"
  id twofamily-deploy || true
  getent passwd twofamily-deploy || true
  passwd -S twofamily-deploy 2>/dev/null || true
  echo "--- PATHS ---"
  stat -c '%U:%G %a %n' /home/twofamily-deploy /home/twofamily-deploy/.ssh /home/twofamily-deploy/.ssh/authorized_keys 2>/dev/null || true
  if command -v ls >/dev/null 2>&1; then
    ls -Zd /home/twofamily-deploy /home/twofamily-deploy/.ssh /home/twofamily-deploy/.ssh/authorized_keys 2>/dev/null || true
  fi
  echo "--- KEY TAG ---"
  grep -c 'twofamily-social-control' /home/twofamily-deploy/.ssh/authorized_keys 2>/dev/null || true
  echo "--- SSHD EFFECTIVE ---"
  /usr/sbin/sshd -T 2>/dev/null | grep -E '^(pubkeyauthentication|passwordauthentication|authorizedkeysfile|allowusers|denyusers|strictmodes|usepam|permitrootlogin)' || true
  echo "--- RECENT SSHD ---"
  journalctl -u sshd -n 40 --no-pager 2>/dev/null | tail -n 25 || true
}


twofamily_fix_deploy_login() {
  id twofamily-deploy >/dev/null 2>&1 || { echo "REFUSED: deploy user missing"; exit 73; }

  local random_password
  random_password="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(48))
PY
)"
  printf 'twofamily-deploy:%s\n' "$random_password" | chpasswd
  unset random_password

  install -d -m 0755 /etc/ssh/sshd_config.d
  cat > /etc/ssh/sshd_config.d/99-twofamily-deploy.conf <<'EOF'
Match User twofamily-deploy
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
EOF
  chmod 0644 /etc/ssh/sshd_config.d/99-twofamily-deploy.conf

  /usr/sbin/sshd -t
  systemctl reload sshd
  passwd -S twofamily-deploy | awk '{print "TWOFAMILY_ACCOUNT_STATE="$2}'
  echo "TWOFAMILY_DEPLOY_LOGIN=READY"
}

case "$CMD" in
  audit) audit ;;
  health) health ;;
  snapshot) snapshot ;;
  shadow) shadow ;;
  head-bundle) head_bundle ;;
  magelle-audit) magelle_audit ;;
  magelle-bootstrap) magelle_bootstrap ;;
  magelle-health) magelle_health ;;
  magelle-admin-check) magelle_admin_check ;;
  magelle-public) magelle_public ;;
  magelle-tls) magelle_tls ;;
  magelle-deploy\ *) magelle_deploy "${CMD#magelle-deploy }" ;;
  twofamily-audit) twofamily_audit ;;
  twofamily-authorize-ephemeral) twofamily_authorize_ephemeral ;;
  twofamily-revoke-ephemeral) twofamily_revoke_ephemeral ;;
  twofamily-enable-deploy-user) twofamily_enable_deploy_user ;;
  twofamily-ssh-diag) twofamily_ssh_diag ;;
  twofamily-fix-deploy-login) twofamily_fix_deploy_login ;;
  deploy\ *) deploy "${CMD#deploy }" ;;
  *) echo "DENIED"; exit 126 ;;
esac
